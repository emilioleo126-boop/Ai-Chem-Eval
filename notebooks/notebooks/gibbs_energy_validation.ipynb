# 🧪 Gibbs Free Energy Validation Demo
# Author: Emilio Leo, Ph.D.
# Project: AI-Chem-Eval
# Description:
# Demonstrates evaluation of AI-generated chemistry explanations 
# using Gibbs free energy calculations.

import pandas as pd
import matplotlib.pyplot as plt

# ---------------------------------------------
# 1. Sample reaction data (ΔH and ΔS)
# ---------------------------------------------

data = {
    "Reaction": ["N2 + 3H2 → 2NH3", "C + O2 → CO2", "CH4 + 2O2 → CO2 + 2H2O"],
    "Delta_H_kJ_mol": [-46, -393, -890],  # Enthalpy change
    "Delta_S_J_molK": [-100, -214, -242], # Entropy change
    "Temperature_K": [298, 298, 298]       # Standard temperature
}

df = pd.DataFrame(data)
df["Delta_H_J_mol"] = df["Delta_H_kJ_mol"] * 1000

# ---------------------------------------------
# 2. Calculate Gibbs Free Energy ΔG = ΔH - TΔS
# ---------------------------------------------

df["Delta_G_J_mol"] = df["Delta_H_J_mol"] - df["Temperature_K"] * df["Delta_S_J_molK"]

print("Calculated Gibbs Free Energy (J/mol):")
print(df[["Reaction", "Temperature_K", "Delta_G_J_mol"]])

# ---------------------------------------------
# 3. Plot ΔG vs ΔH
# ---------------------------------------------

plt.figure(figsize=(8,5))
plt.scatter(df["Delta_H_kJ_mol"], df["Delta_G_J_mol"]/1000, color="darkgreen", s=100)
for i, txt in enumerate(df["Reaction"]):
    plt.annotate(txt, (df["Delta_H_kJ_mol"][i], df["Delta_G_J_mol"][i]/1000),
                 fontsize=8, xytext=(5,5), textcoords="offset points")

plt.xlabel("Enthalpy ΔH (kJ/mol)")
plt.ylabel("Gibbs Free Energy ΔG (kJ/mol)")
plt.title("Relationship Between ΔH and ΔG for Sample Reactions")
plt.grid(True, linestyle="--", alpha=0.6)
plt.tight_layout()
plt.show()

# ---------------------------------------------
# 4. Evaluate an example AI-generated explanation
# ---------------------------------------------

ai_output = """
A reaction with negative ΔG always has a positive ΔH because
the reaction releases energy spontaneously.
"""

print("\nAI Output:")
print(ai_output)

feedback = """
⚠️ Evaluation Feedback:
- The explanation is **incorrect**.
- Negative ΔG indicates spontaneity, but ΔH can be either negative or positive depending on TΔS.
✅ Correct principle:
  ΔG = ΔH - TΔS → Both ΔH and ΔS contribute to spontaneity. Reactions can be exothermic or endothermic.
"""

print(feedback)
