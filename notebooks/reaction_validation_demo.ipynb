# Description:
# A simple example demonstrating data analysis and chemical reasoning
# validation for AI-generated content.

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.constants import R

# ---------------------------------------------
# 1. Sample reaction data
# ---------------------------------------------

data = {
    "Reaction": ["H2 + I2 → 2HI", "CH4 + 2O2 → CO2 + 2H2O", "N2 + 3H2 → 2NH3"],
    "Ea_kJ_mol": [167, 240, 92],  # Activation energies
    "A": [1.2e12, 3.1e13, 5.0e11],  # Pre-exponential factors (1/s)
    "Temperature_K": [500, 700, 650]
}

df = pd.DataFrame(data)
df["Ea_J_mol"] = df["Ea_kJ_mol"] * 1000

# ---------------------------------------------
# 2. Calculate rate constants using Arrhenius equation
# k = A * exp(-Ea / RT)
# ---------------------------------------------

def arrhenius_rate(A, Ea_J_mol, T):
    return A * np.exp(-Ea_J_mol / (R * T))

df["k"] = arrhenius_rate(df["A"], df["Ea_J_mol"], df["Temperature_K"])

print("Calculated rate constants (s⁻¹):")
print(df[["Reaction", "Temperature_K", "k"]])

# ---------------------------------------------
# 3. Plot activation energy vs rate constant
# ---------------------------------------------

plt.figure(figsize=(8, 5))
plt.scatter(df["Ea_kJ_mol"], df["k"], color="royalblue", s=100)
for i, txt in enumerate(df["Reaction"]):
    plt.annotate(txt, (df["Ea_kJ_mol"][i], df["k"][i]), fontsize=8, xytext=(5, 5), textcoords="offset points")

plt.yscale("log")
plt.xlabel("Activation Energy (kJ/mol)")
plt.ylabel("Rate Constant (s⁻¹, log scale)")
plt.title("Arrhenius Relationship Between Ea and Rate Constant")
plt.grid(True, linestyle="--", alpha=0.6)
plt.tight_layout()
plt.show()

# ---------------------------------------------
# 4. Evaluate an example AI-generated explanation
# ---------------------------------------------

ai_output = """
The rate constant increases with higher activation energy because more
energy is available for the reaction to proceed faster.
"""

print("\nAI Output:")
print(ai_output)

feedback = """
⚠️ Evaluation Feedback:
- The explanation is **incorrect**.
- Higher activation energy actually means the reaction requires **more energy** to occur,
  resulting in a **slower rate constant** at the same temperature.
✅ Correct principle:
  k = A * exp(-Ea / RT) → As Ea increases, k decreases (for fixed T).
"""

print(feedback)
